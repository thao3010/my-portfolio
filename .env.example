# API (apps/api)
NODE_ENV=development
PORT=3847
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_USER=portfolio
DATABASE_PASSWORD=portfolio
DATABASE_NAME=portfolio
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth (M2 — optional until configured)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3847/api/v1/auth/google/callback

# MinIO (M2 uploads)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=portfolio
MINIO_USE_SSL=false
